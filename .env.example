# Подключение к базе. Локально — Postgres на своей машине.
# Промышленная площадка определяется 152-ФЗ: база должна стоять в РФ (ТЗ 12.5, 19.4).
DATABASE_URL=postgresql://localhost:5432/klm_dev
DATABASE_POOL_MAX=10

# Подпись сессионной куки. Сгенерировать: openssl rand -base64 32
SESSION_SECRET=замените-на-свой-32-символа-минимум
